# Docker image name for build/push (example: mydockerhubuser/api-gateway)
IMAGE_REPO=mydockerhubuser/api-gateway

# Docker image tag (example: v1, latest)
IMAGE_TAG=latest

# Gateway host port
HOST_PORT=8165

# Eureka URL reachable from inside the container
EUREKA_DEFAULT_ZONE=http://host.docker.internal:8761/eureka/

